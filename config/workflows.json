    {
      "id": "local-code-change",
      "description": "用户明确选择本地代码交付时，开发与评审配合；不自动创建 MR 或推送",
      "delivery_target": "local_diff_and_review",
      "required_inputs": [
        "repository_ref",
        "base_sha",
        "acceptance_criteria",
        "workspace_authorization"
      ],
      "steps": [
        {
          "id": "plan",
          "agent": "orchestrator",
          "skill": "orchestrate-delivery",
          "effect": "read",
          "depends_on": []
        },
        {
          "id": "implement",
          "agent": "developer",
          "skill": "implement-change",
          "effect": "local_write",
          "depends_on": [
            "plan"
          ]
        },
        {
          "id": "review",
          "agent": "reviewer",
          "skill": "review-delivery",
          "effect": "read",
          "depends_on": [
            "implement"
          ]
        },
        {
          "id": "deliver",
          "agent": "orchestrator",
          "skill": "orchestrate-delivery",
          "effect": "read",
          "depends_on": [
            "review"
          ]
        }
