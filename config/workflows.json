      "delivery_target": "answer_with_evidence",
      "required_inputs": [
        "query"
      ],
      "steps": [
        {
          "id": "plan",
          "agent": "orchestrator",
          "skill": "orchestrate-delivery",
          "effect": "read",
          "depends_on": []
