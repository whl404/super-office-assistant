  "unavailable_workflows": [
    {
      "id": "gitlab-mr-delivery",
      "reason": "GitLab MCP 与 Agent 已按用户要求暂停；不能自动替换为 GitHub，也不能把本地差异当成 MR 交付。"
    }
  ]
